        "\\b(?:attorney|lawyer|law firm|law office|bail bonds|tax preparation|tax preparer|h&r block|liberty tax|jackson hewitt)\\b",
        "\\b(?:cafe|coffee shop|restaurant|pizza|tavern|salon|apartments?|wedding venue)\\b"
