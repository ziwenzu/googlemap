{
  "version": "public_service_keywords_v1",
  "scope": "Automatic retrieval of public-facing administrative, policing and postal offices; no human labels or roster linkage.",
  "match_fields": [
    "name",
    "category"
  ],
  "families": [
    {
      "id": "motor_vehicles",
      "label_zh": "DMV／驾照与车辆登记",
      "name_patterns": [
        "\\b(?:department|division|bureau|office) of motor vehicles?\\b",
        "\\bmotor vehicles? (?:department|division|bureau|office)\\b",
        "\\b(?:dmv|bmv|rmv|mvd|omv)\\b",
        "\\bdriver'?s? (?:licen[cs](?:e|ing)|services?) (?:office|center|centre|bureau|division)\\b"
      ],
      "categories": [
        "Department of motor vehicles",
        "Driver's license office",
        "Driver and vehicle licensing agency",
        "License bureau"
      ]
    },
    {
      "id": "police",
      "label_zh": "警局／治安官",
      "name_patterns": [
        "\\bpolice (?:department|station|precinct|office|headquarters|bureau|district)\\b",
        "\\b(?:state|city|county|municipal|metropolitan) police\\b",
        "\\b(?:sheriff'?s?|sheriffs') (?:office|department|station|substation)\\b",
        "\\bhighway patrol\\b"
      ],
      "categories": [
        "Police department",
        "Police station",
        "Police",
        "State police",
        "Sheriff's department",
        "Highway patrol",
        "Civil police"
      ]
    },
    {
